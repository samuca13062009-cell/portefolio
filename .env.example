# Copiar para .env e preencher. O ficheiro .env nunca vai para o repositório.

# Porta e endereço público do site (usado no SEO e no sitemap)
PORT=4180
SITE_URL=http://localhost:4180

# Brevo (https://app.brevo.com > SMTP e API > Chaves de API)
BREVO_API_KEY=
# Remetente verificado na conta Brevo
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Portefólio Samuel Camargo
# Caixa de correio que recebe as mensagens do formulário
CONTACT_TO=

# Email público para pedidos de privacidade (aparece nas páginas legais)
PUBLIC_EMAIL=

# Site no Netlify: o backoffice publica nele e mostra as mensagens do site online (precisa de "netlify login").
NETLIFY_SITE_ID=
